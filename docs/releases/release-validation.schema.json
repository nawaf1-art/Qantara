{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nawaf1-art/Qantara/blob/main/docs/releases/release-validation.schema.json",
  "title": "Qantara release validation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "version",
    "tag",
    "commit",
    "generated_at",
    "status",
    "validations",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "project": { "const": "Qantara" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "status": { "const": "passed" },
    "validations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256", "size_bytes"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
